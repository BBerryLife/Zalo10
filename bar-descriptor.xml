<?xml version="1.0" encoding="utf-8" standalone="no"?>
<qnx xmlns="http://www.qnx.com/schemas/application/1.0">

    <id>com.BerryLife.Zalo10</id>

    <configuration id="com.qnx.qcc.toolChain.666213485" name="Device-Debug">
       <platformArchitecture>armle-v7</platformArchitecture>
       <asset path="arm/o.le-v7-g/Zalo10" entry="true" type="Qnx/Elf">Zalo10</asset>
    </configuration>
    <configuration id="com.qnx.qcc.toolChain.2137696721" name="Device-Release">
       <entryPointType>Qnx/Cascades</entryPointType>
       <platformArchitecture>armle-v7</platformArchitecture>
       <asset path="arm/o.le-v7/Zalo10.so" entry="true" type="Qnx/Elf">Zalo10.so</asset>
    </configuration>
    <configuration id="com.qnx.qcc.toolChain.560740241" name="Device-Profile">
       <platformArchitecture>armle-v7</platformArchitecture>
       <asset path="arm-p/o.le-v7-g/Zalo10" entry="true" type="Qnx/Elf">Zalo10</asset>
    </configuration>
    <configuration id="com.qnx.qcc.toolChain.1655019260" name="Simulator-Debug">
       <platformArchitecture>x86</platformArchitecture>
       <asset path="x86/o-g/Zalo10" entry="true" type="Qnx/Elf">Zalo10</asset>
    </configuration>

    <name>Zalo10</name>
    <versionNumber>1.3.0</versionNumber>
    <description>The Zalo10 application for BB10</description>
    <author>BerryLife</author>
    <buildId>0</buildId>

    <icon>
       <image>icon86.png</image>
       <image>icon90.png</image>
       <image>icon96.png</image>
       <image>icon.png</image>
       <image>icon110.png</image>
    </icon>

    <splashScreens>
       <image>splash.png</image>
       <image>splash720x1280.png</image>
       <image>splash768x1280.png</image>
       <image>splash720.png</image>
       <image>splash1024x600.png</image>
       <image>splash1280x720.png</image>
       <image>splash1280x768.png</image>
       <image>splash600x1024.png</image>
    </splashScreens>

    <initialWindow>
        <systemChrome>none</systemChrome>
        <autoOrients>true</autoOrients>
    </initialWindow>

    <asset path="icon.png">icon.png</asset>
    <asset path="icon86.png">icon86.png</asset>
    <asset path="icon90.png">icon90.png</asset>
    <asset path="icon96.png">icon96.png</asset>
    <asset path="icon110.png">icon110.png</asset>
    <asset path="splash.png">splash.png</asset>
    <asset path="splash720x1280.png">splash720x1280.png</asset>
    <asset path="splash768x1280.png">splash768x1280.png</asset>
    <asset path="splash720.png">splash720.png</asset>
    <asset path="splash1024x600.png">splash1024x600.png</asset>
    <asset path="splash1280x720.png">splash1280x720.png</asset>
    <asset path="splash1280x768.png">splash1280x768.png</asset>
    <asset path="splash600x1024.png">splash600x1024.png</asset>
    <asset path="assets">assets</asset>
    <!-- PreviewNoti.png cần đọc được bởi Hub process (khác process với app),
         nên phải khai báo public="true" riêng — asset "assets" ở dòng trên
         là private (chỉ app tự đọc được), không đủ cho UDS icon/instant
         preview. Khi public, file này được cài vào app/public/... thay vì
         app/native/..., xem HubIntegration.cpp (assetPath) và
         ZaloService_Messages.cpp (Notification::setIconUrl) phải khớp path
         "assets/images/PreviewNoti.png" này. -->
    <asset path="assets/images/PreviewNoti.png" public="true">assets/images/PreviewNoti.png</asset>
    <asset path="translations" dest="qm">
        <include name="*.qm"/>
    </asset>

    <permission system="true">run_native</permission>
    <permission>access_internet</permission>
    <permission>access_location_services</permission>
    <permission>post_notification</permission>
    <permission>access_notify_settings_control</permission>
    <permission>run_when_backgrounded</permission>
    <permission system="true">_sys_run_headless</permission>
    <permission system="true">_sys_headless_nostop</permission>
    <!-- Bắt buộc cho UDS (Unified Data Source / Hub integration, xem
         src/HubIntegration.cpp): PPS object "/pps/services/pim/unified" mà
         uds_register_client() nói chuyện tới được BlackBerry bảo vệ bởi
         quyền hệ thống này. Đây là quyền hạn chế ("_sys_" prefix) — theo
         tài liệu BlackBerry, cần GỬI YÊU CẦU RIÊNG tới BlackBerry để được
         cấp (không tự động có chỉ vì khai báo trong bar-descriptor.xml, dù
         vẫn phải khai báo). Nếu app được build/sign qua quy trình nội bộ
         không qua BlackBerry (self-signed / debug token), quyền restricted
         này có thể không được thực thi chặt — nhưng để chạy đúng trên thiết
         bị production/qua BlackBerry World trước đây thì cần xin cấp. -->
    <permission system="true">_sys_access_pim_unified</permission>
    <permission>access_wifi_public</permission>
    <permission>access_shared</permission>
    <permission>access_pimdomain_calendars</permission>
    <permission>use_camera</permission>
    <permission>access_pimdomain_contacts</permission>
    <permission>record_audio</permission>
    <permission>read_personally_identifiable_information</permission>
    <permission>access_phone</permission>
    <permission system="true">_sys_inject_voice</permission>
    <permission>read_phonecall_details</permission>
    <permission>control_phone</permission>
    <permission>access_pimdomain_calllogs</permission>
    <permission>read_device_identifying_information</permission>

    <env var="LD_LIBRARY_PATH" value="app/native/lib:/usr/lib/qt4/lib"/>
    <env var="CASCADES_THEME" value="default"/>

    <!-- Invocation target for BlackBerry Hub notifications.
         When the user taps a Hub notification, BB10 invokes this target
         which wakes/brings the app to foreground and fires InvokeManager::invoked().
         The data payload is "threadId|isGroup" set by ZaloService. -->
    <invoke-target id="com.BerryLife.Zalo10.invoke">
        <invoke-target-type>application</invoke-target-type>
        <filter>
            <action>bb.action.OPEN</action>
            <mime-type>text/plain</mime-type>
        </filter>
    </invoke-target>

    <!-- Active frame images (resolution-aware, selected at runtime via DisplayInfo) -->
    <!-- 720x720  (Q10/Q5)      -> medium -->
    <!-- 720x1280 (Z10/Z30/Z3)  -> big    -->
    <!-- 1440x1440 (Passport)   -> big + small -->
    <asset path="assets/images/ActiveFrame/activeframe_zl10_big.png">assets/images/ActiveFrame/activeframe_zl10_big.png</asset>
    <asset path="assets/images/ActiveFrame/activeframe_zl10_medium.png">assets/images/ActiveFrame/activeframe_zl10_medium.png</asset>
    <asset path="assets/images/ActiveFrame/Activeframe_zl10_Small.png">assets/images/ActiveFrame/Activeframe_zl10_Small.png</asset>

</qnx>
